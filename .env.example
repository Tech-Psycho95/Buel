# ---- Database (required) ----
# Postgres connection string (REQUIRED in production). Use Neon or Supabase.
# For Neon on Vercel, use the POOLED connection string (host contains
# "-pooler", port 6543) — the client below automatically disables prepared
# statements for pooled hosts, as Neon's PgBouncer requires.
# Locally, if unset, BUEL falls back to an embedded Postgres (PGlite) stored
# in .data/pglite — for development and tests only, never for production.
DATABASE_URL=

# Run Drizzle migrations on first boot (serverless-friendly alternative to
# `drizzle-kit migrate`). Set to "1" on Vercel for the demo, or run the
# migration once locally against Neon instead (recommended for shared DBs).
SENTISEL_AUTO_MIGRATE=0

# ---- Grok / xAI (optional) ----
# When set, agent narratives are generated by xAI's Grok API. When absent,
# failing or returning invalid output, deterministic rules-based narrative
# templates are used instead (the Council, Judge and Gate never depend on it).
# Create a key at https://console.x.ai. Server-side only — never NEXT_PUBLIC_.
XAI_API_KEY=
# Grok model id (default: grok-4.7). Pin another model available on the account.
XAI_MODEL=grok-4.7

# ---- App ----
# Secret used to sign/verify internal tokens (generate: openssl rand -hex 32)
SENTISEL_SECRET=change-me

# Force deterministic demo market data (skips live Hyperliquid calls)
SENTISEL_DEMO_DATA=0

# ---- Privy authentication (required for sign-in) ----
# Create an app at https://dashboard.privy.io, then:
#   NEXT_PUBLIC_PRIVY_APP_ID  — safe to expose (public app id)
#   PRIVY_APP_SECRET          — SERVER-SIDE ONLY, never exposed to the browser
# Configure allowed origins in the Privy dashboard: localhost:3111 (dev) and
# the production domain. Login methods: email OTP, Google, wallet, passkey.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# DEV/TEST ONLY: enables the dev-only Privy test-session minter + fallback
# verifier for automated tests. Refuses whenever NODE_ENV=production.
# (generate: openssl rand -hex 32)
SENTISEL_TEST_SECRET=
